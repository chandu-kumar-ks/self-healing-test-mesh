# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# API key for an OpenAI-compatible chat completions endpoint.
LLM_API_KEY=your_api_key_here

# Base URL of the API (OpenAI, Azure OpenAI, or any OpenAI-compatible provider).
LLM_API_BASE=https://api.openai.com/v1

# Model name to use for locator suggestions.
LLM_MODEL=gpt-4o-mini

# Safety cap on how many AI-suggested locators will be tried per failure.
MAX_HEALING_ATTEMPTS=3

# Run the browser headless (true/false).
HEADLESS=true
