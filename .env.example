# Local mock LLM configuration
# The included mock server does not require a real API key.
# Never commit the real .env file.

LLM_API_KEY=mock-key
LLM_API_BASE=http://127.0.0.1:8000/v1
LLM_MODEL=mock-gpt-4o-mini

# Safety cap on how many AI-suggested locators will be tried per failure.
MAX_HEALING_ATTEMPTS=3

# Run the browser headless (true/false).
HEADLESS=true

# Optional request timeout in seconds.
LLM_REQUEST_TIMEOUT=20
